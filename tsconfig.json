{
    "compilerOptions": {
        "target": "ES6",
        "lib": ["ES2019", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "outDir": "./out",
        "rootDir": "./src",
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "sourceMap": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": ["src/**/*.ts", "src/**/*.tsx", "globals.d.ts"],
    "exclude": ["node_modules", "dist", "bin"]
}
